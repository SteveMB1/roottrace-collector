# RootTrace collector configuration (systemd EnvironmentFile).
#
# Read by roottrace-collector.service and by roottrace-collector-setup.
# Root-owned, mode 0600: optional entries below carry read-only database
# credentials. The package manager never overwrites this file on upgrade.
#
# ROOTTRACE_API_URL and ROOTTRACE_COLLECTOR_TOKEN are both required, and the
# service stops without them. Point the URL at your own deployment's HTTPS
# `/api` endpoint. On first install:
#   sudo roottrace-collector-setup apply       # ACLs, audit rules, SELinux
#   sudo systemctl enable --now roottrace-collector.service
#
# After later edits, restart the service to load this file:
#   sudo systemctl restart roottrace-collector.service
# Rerun setup apply only after changing settings that manage ACLs, audit
# rules, or SELinux.
#
# The full key reference lives at https://roottrace.io/docs/collector/.
# Values with spaces or shell metacharacters should be double-quoted.

# e.g. https://roottrace.example.com/api  (RootTrace Cloud: https://api.roottrace.io/api)
ROOTTRACE_API_URL=
ROOTTRACE_COLLECTOR_TOKEN=
ROOTTRACE_INTERVAL_SECONDS=60
ROOTTRACE_MAX_RUNTIME_SECONDS=86400
ROOTTRACE_STREAMING=false
ROOTTRACE_ENABLED_CHECKS=disk,inode,disk_io,swap,memory,cpu,network,tcp,process,systemd,kernel,linux_audit,ec2,collector_self,custom

# Bundled custom-metric monitors; append your own directories comma-separated
# (e.g. /etc/roottrace/custom_metrics.d).
ROOTTRACE_CUSTOM_METRICS_PATHS=/usr/libexec/roottrace-collector/additional_monitors
ROOTTRACE_CUSTOM_METRICS_MAX_FILES=16

# Leave empty to auto-detect (kubernetes/docker/ec2/bare_metal). Set a value
# only to force it — any non-empty value skips detection entirely.
ROOTTRACE_PROVIDER=
ROOTTRACE_SERVICE_NAME=
ROOTTRACE_SERVICE_TYPE=

# ── Linux audit ingestion ─────────────────────────────────────────────────────
# roottrace-collector-setup reads these when installing the STIG audit rules
# and the auditd realtime plugin; the collector reads them at runtime.
#
# ROOTTRACE_KERNEL_JOURNAL_ACCESS gates only whether the collector attempts
# journal-backed checks. The packaged unit grants the systemd-journal group
# statically; to take journal access away entirely, also drop the group with
# a drop-in:  systemctl edit roottrace-collector  ->  [Service]
# SupplementaryGroups=  (empty line clears it).
ROOTTRACE_KERNEL_JOURNAL_ACCESS=true
ROOTTRACE_LINUX_AUDIT_ENABLED=true
ROOTTRACE_LINUX_AUDIT_ACCESS=true
# Audit every exec, not only the privilege-changing ones the STIG rules cover.
# This is what corroborates an APM security signal: the SDK reports that the
# application spawned a process, and the kernel independently records the same
# exec. Deliberately not filtered by login uid — a service started by systemd
# has none, which is exactly the case that matters.
#
# Volume is one record per process started, not per file touched: this rule set
# never audits successful file opens, only denied ones. Set false on hosts that
# fork constantly (CI runners, shell-heavy cron); the STIG rules stay either
# way. Rerun `roottrace-collector-setup apply` after changing this.
ROOTTRACE_LINUX_AUDIT_EXEC=true
ROOTTRACE_LINUX_AUDIT_LOG_PATHS=/var/log/audit/audit.log
ROOTTRACE_LINUX_AUDIT_BATCH_EVENTS=250
ROOTTRACE_LINUX_AUDIT_STREAMING=false
ROOTTRACE_LINUX_AUDIT_AUDITD_PLUGIN=true
# Opt in only after reviewing the RHEL 9 STIG rules. The final rule makes the
# running audit configuration immutable until reboot.
ROOTTRACE_LINUX_AUDIT_STIG_RULES=false
ROOTTRACE_LINUX_AUDIT_BACKLOG_LIMIT=8192
ROOTTRACE_LINUX_AUDIT_BACKLOG_WAIT_TIME=0
ROOTTRACE_LINUX_AUDIT_RULES_DIR=/etc/audit/rules.d
ROOTTRACE_LINUX_AUDIT_PLUGIN_FLUSH_SECONDS=2
ROOTTRACE_LINUX_AUDIT_PLUGIN_MINIMAL_HOST=true
ROOTTRACE_LINUX_AUDIT_RELOAD_AUDITD=true
ROOTTRACE_LINUX_AUDIT_MAX_BYTES_PER_CYCLE=4194304
ROOTTRACE_LINUX_AUDIT_INITIAL_LOOKBACK_BYTES=1048576
ROOTTRACE_LINUX_AUDIT_RESOLVE_USERS=true
ROOTTRACE_LINUX_AUDIT_UID_CACHE_SIZE=4096

# ── Optional host checks ──────────────────────────────────────────────────────
# Uncomment and fill in what this host runs; the collector guide documents
# every key. Credentials here should be read-only accounts.
#ROOTTRACE_CHECK_PORTS=mongodb:27017,postgres:5432,redis:6379
#ROOTTRACE_PROCESS_NAMES=mongod,postgres,redis-server,nginx
#ROOTTRACE_SYSTEMD_UNITS=mongod.service,postgresql.service,nginx.service
